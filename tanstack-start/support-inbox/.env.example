# Only needed for local development. On Appwrite Sites the endpoint and project
# are injected, and each request carries an ephemeral API key on x-appwrite-key.
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<PROJECT_ID>
APPWRITE_API_KEY=

# Set on the site in every environment. /setup asks for it before anyone can
# claim a fresh deployment.
MAILROOM_SETUP_TOKEN=

# Self-hosted only: the Appwrite endpoint browsers use for Realtime, when the
# site reaches Appwrite on an internal address.
# APPWRITE_PUBLIC_ENDPOINT=https://appwrite.example.com/v1
